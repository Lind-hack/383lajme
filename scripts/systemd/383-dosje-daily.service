[Unit]
Description=383 Dosje daily run (topics, research, verified publishing, one email)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
# GPT-6 Luna is shared with the hourly news writer: never start while it runs.
ExecStartPre=/bin/sh -c '! systemctl is-active --quiet 383-production.service'
ExecStart=/usr/bin/docker exec --user hermes --env HOME=/opt/data/home --env L383_REPO=/opt/data/workspaces/383lajme-dosje-main --env DOSJE_ENV_FILE=/opt/data/tregu-daily.env --env DOSJE_ARGS=${DOSJE_ARGS} hermes /bin/sh /opt/data/workspaces/383lajme-dosje-main/scripts/run-dosje-daily.sh
# DOSJE_ARGS is unset for the scheduled run (systemd expands it to nothing).
# One-off runs (--backfill, --dry-run) are started with systemd-run instead.
# The script stops starting model calls at 06:40; publishing and the email can
# take a few minutes more, inside the wrapper's 7800s bound.
TimeoutStartSec=8100
StandardOutput=journal
StandardError=journal
SyslogIdentifier=383-dosje-daily
