# Pipeline API keys (required for automated news generation)
ANTHROPIC_API_KEY=your_anthropic_key_here
DEEPL_API_KEY=your_deepl_key_here

# Google Analytics 4 (public client ID from the GA4 data stream, G-XXXXXXXXXX).
# Analytics stays dormant until this is set AND the reader accepts cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional exact-place imagery for Visit nearby services. Enable Places API
# (New) and Place Photos (New). Keep this server-only and restrict it by API.
GOOGLE_MAPS_PLATFORM_API_KEY=your_google_maps_platform_key

# Telegram news dispatch (app/api/cron/dispatch-telegram).
# Bot token from @BotFather; channel id as @publicname or -100… numeric id.
# The bot must be an admin of the channel with "Post Messages" rights.
TELEGRAM_BOT_TOKEN=123456:ABC-your_botfather_token
TELEGRAM_CHANNEL_ID=@your_channel
# Public t.me join link shown by the homepage alerts CTA.
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/your_channel
# Until this is set the WhatsApp button renders as "së shpejti" rather than as
# a live button pointing at nothing.
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=https://chat.whatsapp.com/your_invite

# Hosted scheduler: Vercel Cron dispatches the GitHub Actions worker.
CRON_SECRET=generate_a_long_random_secret
CODEX_PUSH_TOKEN=github_token_with_actions_workflow_permission

# Ghost CMS (optional — falls back to SQLite pipeline / mock data)
GHOST_URL=https://your-ghost-site.ghost.io
GHOST_CONTENT_API_KEY=your_content_api_key_here

# 383 Tregu (prediction markets)
GROQ_API_KEY=your_groq_key_here
# Service-role key (Supabase dashboard -> Project Settings -> API -> service_role).
# Server-only — never expose via NEXT_PUBLIC_. Used by admin/cron routes to
# create/approve/resolve markets and write AI probability snapshots, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# OpenF1 (optional, and only optional between sessions).
# While any F1 session is live, OpenF1 answers 401 to unauthenticated callers
# for every endpoint, including historical ones - which is exactly the window
# the F1 markets need it. Without these the pipeline still runs, it just goes
# quiet during practice, qualifying and the race.
# OAuth2 password grant against https://api.openf1.org/token (see br-g/openf1,
# src/openf1/util/openf1_client.py). Keys: https://openf1.org
OPENF1_CLIENT_ID=
OPENF1_CLIENT_SECRET=
