{
  "version": 2,
  "name": "383 Lajme Topic Selection v2 article batch",
  "categories": [
    "Kosovë",
    "Shqipëri",
    "Botë",
    "Sport",
    "Showbiz",
    "Ekonomi",
    "Teknologji"
  ],
  "article_template": [
    "id",
    "slug",
    "url",
    "title",
    "excerpt",
    "body",
    "source",
    "category",
    "published_at",
    "reading_time",
    "featured",
    "engagement_score",
    "score_reason",
    "score_breakdown",
    "score_formula",
    "image_url",
    "image_width",
    "image_height",
    "city",
    "corroborating_sources",
    "created_at"
  ],
  "properties": {
    "id": {"type": "string"},
    "slug": {"type": "string"},
    "url": {"type": "string", "format": "uri"},
    "title": {"type": "string", "maxLength": 65},
    "excerpt": {"type": "string"},
    "body": {"type": "string"},
    "source": {"type": "string"},
    "category": {"enum": ["Kosovë", "Shqipëri", "Botë", "Sport", "Showbiz", "Ekonomi", "Teknologji"]},
    "published_at": {"type": "string"},
    "reading_time": {"type": "integer", "minimum": 1},
    "featured": {"type": "boolean"},
    "engagement_score": {"type": "number"},
    "score_reason": {"type": "string"},
    "score_breakdown": {"type": "object"},
    "score_formula": {"type": "string"},
    "image_url": {"type": "string", "format": "uri"},
    "image_width": {"type": "integer", "minimum": 1200},
    "image_height": {"type": "integer", "minimum": 675},
    "city": {"type": ["string", "null"]},
    "corroborating_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "url"],
        "properties": {
          "source": {"type": "string"},
          "url": {"type": "string", "format": "uri"}
        }
      }
    },
    "created_at": {"type": "string"}
  },
  "run_contract": {
    "minimum_articles": 13,
    "maximum_articles": 20,
    "minimum_by_category": {
      "Kosovë": 6,
      "Shqipëri": 3,
      "Botë": 3,
      "Sport": 2,
      "Showbiz": 1
    },
    "maximum_by_category": {
      "Botë": 4,
      "Sport": 3,
      "Showbiz": 2
    },
    "independent_sources_required": 2,
    "city_inference": "title plus first 200 body words; supplied priority order; national fallback"
  }
}
