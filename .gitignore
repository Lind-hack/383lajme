# Next.js
.next/
out/
node_modules/
.vercel/

# SQLite — not committed; pipeline writes JSON to data/auto-articles/ instead
data/articles.db

# Python
__pycache__/
*.py[cod]
.env
.env.local
.env*.local
# Holds live API keys and passwords; must never be committed.
.env.automation
.firecrawl/

# OS
.DS_Store
Thumbs.db

# UI-iteration screenshots dropped in the repo root. Leading slash = top level
# only, so app/icon.png, app/apple-icon.png and public/ assets stay tracked.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp

# Pipeline scratch. b256881 committed 23.5 MB of scraped source pages from
# these two directories, which buried the repo's real languages under 85% HTML
# and dragged 27 MB of other outlets' pages into every clone. The discovery
# markdown in .last30days is regenerated by codex-cloud-news.yml each run and
# stays tracked; the downloaded pages and images do not belong in git.
tmp/
.last30days/**/*.html
.last30days/**/*.png
.last30days/**/*.jpg
.last30days/**/*.jpeg
.last30days/**/*.webp
